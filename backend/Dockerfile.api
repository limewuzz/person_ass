# mwcp-api 镜像（PROPOSAL——未构建未部署；R4 A2 要求静态可审查）
# 注意：tag 未锁 digest；部署 Gate 时以实际拉取 digest 锁定并记录（不预填臆造值）
FROM python:3.12-slim

WORKDIR /opt/magicworkshop
# 依赖先拷（层缓存）：requirements.lock 为权威
COPY backend/requirements.lock backend/requirements-postgres.lock ./backend/
RUN pip install --no-cache-dir -r backend/requirements-postgres.lock

COPY backend/ ./backend/
COPY dbpg/ ./dbpg/
COPY contracts/ ./contracts/
RUN chmod +x backend/entrypoint.sh && useradd --system --uid 10001 --no-create-home mwcp
USER mwcp
ENV PYTHONPATH=/opt/magicworkshop/backend:/opt/magicworkshop

EXPOSE 8123
ENV MWCP_LISTEN_HOST=0.0.0.0 MWCP_LISTEN_PORT=8123
# 注意：容器内监听 0.0.0.0（容器命名空间）；宿主暴露面由 compose 的 127.0.0.1:8123:8123 唯一决定
ENTRYPOINT ["/opt/magicworkshop/backend/entrypoint.sh"]
